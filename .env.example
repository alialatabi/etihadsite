# Copy to .env.local for local development. Never commit .env.local.

# Admin dashboard (/admin). Required: ADMIN_PASSWORD min 8 chars; placeholder values (change-me...) are rejected.
ADMIN_PASSWORD=
# 32+ random characters used to sign the admin session cookie. Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Storage: "local" writes files under DATA_DIR (default ./data).
# "supabase" (for hosting on Vercel): Postgres tables + private bucket, see supabase/migrations.
STORAGE=local
DATA_DIR=./data
# Only for STORAGE=supabase. The SECRET key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Order notification: "console" (log only) or "telegram".
ORDER_TRANSPORT=console
TELEGRAM_BOT_TOKEN=
# Chat id is also editable in /admin/settings; env wins when set.
TELEGRAM_CHAT_ID=

# Cloudflare Turnstile (anti-spam): KEEP BOTH EMPTY for now. Only the server-side check exists
# (POST /api/orders). No page renders a Turnstile widget or sends a token, so setting the secret
# makes every order fail with captcha_failed. NEXT_PUBLIC_TURNSTILE_SITE_KEY is not read by any code yet.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Trusted reverse-proxy hops for x-forwarded-for (default 0 = ignore the header and use
# global per-route rate limits). Set to 1 behind nginx/Caddy, and on Vercel, for per-IP limiting.
TRUST_PROXY=0

# Hosting only: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/purge (16+ chars).
CRON_SECRET=
