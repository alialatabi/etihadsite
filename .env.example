# Copy to .env.local for local development. Never commit .env.local.

# Admin dashboard (/admin). Required: ADMIN_PASSWORD min 8 chars; placeholder values (change-me...) are rejected.
ADMIN_PASSWORD=
# 32+ random characters used to sign the admin session cookie. Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Storage: "local" writes files under DATA_DIR (default ./data).
STORAGE=local
DATA_DIR=./data

# Order notification: "console" (log only) or "telegram".
ORDER_TRANSPORT=console
TELEGRAM_BOT_TOKEN=
# Chat id is also editable in /admin/settings; env wins when set.
TELEGRAM_CHAT_ID=

# Optional Cloudflare Turnstile (anti-spam). Leave empty to disable.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Trusted reverse-proxy hops for x-forwarded-for (default 0 = ignore the header and use
# global per-route rate limits). Set to 1 behind nginx/Caddy for per-IP limiting.
TRUST_PROXY=0
