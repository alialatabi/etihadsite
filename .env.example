# Copy to .env.local for local development. Never commit .env.local.

# Admin dashboard (/admin). Required: ADMIN_PASSWORD min 8 chars; placeholder values (change-me...) are rejected.
ADMIN_PASSWORD=
# 32+ random characters used to sign the admin session cookie. Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Storage: "local" writes files under DATA_DIR (default ./data).
# "supabase" (for hosting on Vercel): Postgres tables + private bucket, see supabase/migrations.
STORAGE=local
DATA_DIR=./data
# Only for STORAGE=supabase. The SECRET key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Order notification: "console" (log only) or "telegram".
ORDER_TRANSPORT=console
TELEGRAM_BOT_TOKEN=
# Chat id is also editable in /admin/settings; env wins when set.
TELEGRAM_CHAT_ID=

# Cloudflare Turnstile (anti-spam): KEEP BOTH EMPTY for now. Only the server-side check exists
# (POST /api/orders). No page renders a Turnstile widget or sends a token, so setting the secret
# makes every order fail with captcha_failed. NEXT_PUBLIC_TURNSTILE_SITE_KEY is not read by any code yet.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Trusted reverse-proxy hops for x-forwarded-for (default 0 = ignore the header and use
# global per-route rate limits). Set to 1 behind nginx/Caddy, and on Vercel, for per-IP limiting.
TRUST_PROXY=0

# Hosting only: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/purge (16+ chars).
CRON_SECRET=

# Hidden staff page: /staff/<STAFF_PAGE_KEY>. At least 24 random characters; missing or shorter = the page is a 404.
# Anyone with the link can open the page, so share it only with employees. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
STAFF_PAGE_KEY=

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────────────────────
# Sends every error a customer hits to your own sentry.io account (errors only: no screen
# recording, no speed measuring). Leave all of these EMPTY and nothing is sent (local development).
# The site scrubs the staff link, phone numbers, signed upload links, cookies and user details
# before anything leaves. Also tick "Prevent Storing of IP Addresses" in the sentry.io project
# settings (Settings -> Security & Privacy).
#
# DSN: sentry.io -> your project -> Settings -> Client Keys (DSN). It looks like
#   https://abc123@o123456.ingest.de.sentry.io/456789
# It is safe to be public (it is visible in the browser anyway). It is baked in at BUILD time:
# after setting or changing it on Vercel, REDEPLOY, otherwise the site keeps the old value.
NEXT_PUBLIC_SENTRY_DSN=
# Optional name shown in Sentry for server errors, e.g. production. Empty = taken from Vercel.
SENTRY_ENVIRONMENT=
# Optional, build time only: readable error locations (source maps). Without them everything still
# works and errors are just harder to read. SENTRY_AUTH_TOKEN is SECRET: put it only in Vercel's
# environment variables (or your shell), never in a file you commit.
#   SENTRY_AUTH_TOKEN: create one at https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/
#   SENTRY_ORG / SENTRY_PROJECT: the short names ("slugs") of your organisation and project, as in the sentry.io address
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
