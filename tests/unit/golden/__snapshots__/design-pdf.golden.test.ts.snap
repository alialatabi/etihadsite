exports[`golden: sniffKind > magic-byte table 1`] = `
[
  "empty -> null",
  "png full signature -> "png"",
  "png first 4 bytes + 4 other (still png) -> "png"",
  "png signature cut to 7 bytes -> null",
  "jpeg 3 bytes -> "jpeg"",
  "jpeg 2 bytes -> null",
  "jpeg JFIF -> "jpeg"",
  "pdf %PDF- -> "pdf"",
  "pdf %PDF without dash -> null",
  "pdf with leading whitespace -> null",
  "gif -> null",
  "webp -> null",
  "svg text -> null",
  "zeros -> null",
]
`;
