exports[`golden: deepMerge > table 1`] = `
[
  "scalar over scalar: 1 + 2 -> 2",
  "undefined keeps base: {"a":1} + undefined -> {"a":1}",
  "null replaces base: {"a":1} + null -> null",
  "array replaces object: {"a":1} + [1,2] -> [1,2]",
  "object over scalar: 5 + {"a":1} -> {"a":1}",
  "nested merge: {"a":{"b":1,"c":2},"d":3} + {"a":{"c":9}} -> {"a":{"b":1,"c":9},"d":3}",
  "arrays are replaced, not merged: {"a":[1,2,3]} + {"a":[9]} -> {"a":[9]}",
  "new keys are added: {"a":1} + {"b":2} -> {"a":1,"b":2}",
  "nested undefined keeps base: {"a":{"b":1}} + {"a":{"b":"<undefined>"}} -> {"a":{"b":1}}",
  "nested null replaces: {"a":{"b":1}} + {"a":null} -> {"a":null}",
  "over has object where base has scalar: {"a":1} + {"a":{"x":1}} -> {"a":{"x":1}}",
  "empty over: {"a":1} + {} -> {"a":1}",
]
`;

