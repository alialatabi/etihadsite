exports[`golden: admin proxy (src/proxy.ts) > matcher config 1`] = `
{
  "matcher": [
    "/admin/:path*",
    "/api/admin/:path*",
    "/staff/:path*",
    "/staff-sheets",
  ],
}
`;

exports[`golden: admin proxy (src/proxy.ts) > who gets through, who is redirected, who gets 401 1`] = `
[
  "login page, no cookie -> 200 next()",
  "admin home, no cookie -> 307 redirect https://softy.iq/admin/login",
  "admin page, no cookie, with query -> 307 redirect https://softy.iq/admin/login",
  "admin page, valid cookie -> 200 next()",
  "admin page, expired cookie -> 307 redirect https://softy.iq/admin/login",
  "admin page, garbage cookie -> 307 redirect https://softy.iq/admin/login",
  "admin api, no cookie -> 401 response {"ok":false,"error":"unauthorized"}",
  "admin api, valid cookie -> 200 next()",
  "admin api, expired cookie -> 401 response {"ok":false,"error":"unauthorized"}",
  "login page with a trailing slash is NOT the login page -> 307 redirect https://softy.iq/admin/login",
  "login sub-path -> 307 redirect https://softy.iq/admin/login",
  "redirect keeps the request origin -> 307 redirect http://localhost:3000/admin/login",
  "valid cookie but SESSION_SECRET unset -> 307 redirect https://softy.iq/admin/login",
]
`;

exports[`golden: admin session token > checkPassword 1`] = `
[
  "explicit match -> true",
  "explicit mismatch -> false",
  "different length -> false",
  "empty vs empty -> true",
  "unicode -> true",
  "case sensitive -> false",
  "from env, right -> true",
  "from env, wrong -> false",
  "from env, not configured -> THROWS Invalid environment variables: ADMIN_PASSWORD, SESSION_SECRET",
]
`;

