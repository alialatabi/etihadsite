  "password 7 chars -> admin: THROWS Invalid environment variables: ADMIN_PASSWORD | all: THROWS Invalid environment variables: ADMIN_PASSWORD",
  "password 8 chars -> admin: {"ADMIN_PASSWORD":"12345678","SESSION_SECRET":"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"} | all: STORAGE,DATA_DIR,ORDER_TRANSPORT,TRUST_PROXY,ADMIN_PASSWORD,SESSION_SECRET",
  "password placeholder -> admin: THROWS Invalid environment variables: ADMIN_PASSWORD | all: THROWS Invalid environment variables: ADMIN_PASSWORD",
  "password starts with the placeholder -> admin: THROWS Invalid environment variables: ADMIN_PASSWORD | all: THROWS Invalid environment variables: ADMIN_PASSWORD",
  "password contains but does not start with it -> admin: {"ADMIN_PASSWORD":"i-will-change-me","SESSION_SECRET":"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"} | all: STORAGE,DATA_DIR,ORDER_TRANSPORT,TRUST_PROXY,ADMIN_PASSWORD,SESSION_SECRET",
  "secret 31 chars -> admin: THROWS Invalid environment variables: SESSION_SECRET | all: THROWS Invalid environment variables: SESSION_SECRET",
  "secret 32 chars -> admin: {"ADMIN_PASSWORD":"admin1234","SESSION_SECRET":"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"} | all: STORAGE,DATA_DIR,ORDER_TRANSPORT,TRUST_PROXY,ADMIN_PASSWORD,SESSION_SECRET",
  "secret placeholder (long enough) -> admin: THROWS Invalid environment variables: SESSION_SECRET | all: THROWS Invalid environment variables: SESSION_SECRET",
  "secret example value (too short anyway) -> admin: THROWS Invalid environment variables: SESSION_SECRET, SESSION_SECRET | all: THROWS Invalid environment variables: SESSION_SECRET, SESSION_SECRET",
  "blank password is NOT treated as unset here -> admin: {"ADMIN_PASSWORD":"        ","SESSION_SECRET":"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"} | all: STORAGE,DATA_DIR,ORDER_TRANSPORT,TRUST_PROXY,ADMIN_PASSWORD,SESSION_SECRET",
  "both invalid -> admin: THROWS Invalid environment variables: ADMIN_PASSWORD, SESSION_SECRET | all: THROWS Invalid environment variables: ADMIN_PASSWORD, SESSION_SECRET",
  "admin valid, order env invalid -> admin: {"ADMIN_PASSWORD":"admin1234","SESSION_SECRET":"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"} | all: THROWS Invalid environment variables: STORAGE",
]
`;

exports[`golden: env > getOrderEnv table 1`] = `
[
  "nothing set -> {"DATA_DIR":"./data","ORDER_TRANSPORT":"console","STORAGE":"local","TRUST_PROXY":0}",
  "blank strings count as unset -> {"DATA_DIR":"./data","ORDER_TRANSPORT":"console","STORAGE":"local","TRUST_PROXY":0}",
  "everything set -> {"DATA_DIR":"/data","ORDER_TRANSPORT":"telegram","STORAGE":"supabase","SUPABASE_SECRET_KEY":"sk","SUPABASE_URL":"https://p.supabase.co","TELEGRAM_BOT_TOKEN":"1:a","TELEGRAM_CHAT_ID":"5","TRUST_PROXY":2,"TURNSTILE_SECRET_KEY":"t"}",
  "values are not trimmed -> {"DATA_DIR":" ./d ","ORDER_TRANSPORT":"console","STORAGE":"local","TELEGRAM_CHAT_ID":" 5 ","TRUST_PROXY":0}",
  "TRUST_PROXY 10 -> {"DATA_DIR":"./data","ORDER_TRANSPORT":"console","STORAGE":"local","TRUST_PROXY":10}",
  "TRUST_PROXY 11 -> THROWS Invalid environment variables: TRUST_PROXY",
  "TRUST_PROXY -1 -> THROWS Invalid environment variables: TRUST_PROXY",
  "TRUST_PROXY 1.5 -> THROWS Invalid environment variables: TRUST_PROXY",
  "TRUST_PROXY abc -> THROWS Invalid environment variables: TRUST_PROXY",
  "TRUST_PROXY " 2 " -> {"DATA_DIR":"./data","ORDER_TRANSPORT":"console","STORAGE":"local","TRUST_PROXY":2}",
  "unknown STORAGE -> THROWS Invalid environment variables: STORAGE",
  "upper-case STORAGE -> THROWS Invalid environment variables: STORAGE",
  "unknown ORDER_TRANSPORT -> THROWS Invalid environment variables: ORDER_TRANSPORT",
  "two invalid values -> THROWS Invalid environment variables: STORAGE, ORDER_TRANSPORT",
  "admin secrets are not needed (and not returned) -> {"DATA_DIR":"./data","ORDER_TRANSPORT":"console","STORAGE":"local","TRUST_PROXY":0}",
]
`;

exports[`golden: logClient (browser -> /api/log) > exact fetch call; never throws 1`] = `
{
  "calls": 2,
  "first": {
    "init": {
      "body": "{"step":"decode","message":"boom","userAgent":"GoldenBrowser/1.0"}",
      "headers": {
        "content-type": "application/json",
      },
      "keepalive": true,
      "method": "POST",
    },
    "url": "/api/log",
  },
  "rejected": "undefined",
  "second": {
    "body": {
      "fileSize": 12345,
      "fileType": "image/png",
      "message": "500 chars",
      "step": "upload",
      "userAgent": "Custom/1",
    },
    "bodyKeyOrder": "step,message,fileType,fileSize,userAgent",
    "url": "/api/log",
  },
  "threw": "undefined",
}
`;

exports[`golden: rate limiter > clientIp / trustProxyHops 1`] = `
{
  "hops": [
    "TRUST_PROXY=undefined -> hops=0 clientIp=global",
    "TRUST_PROXY="" -> hops=0 clientIp=global",
    "TRUST_PROXY="0" -> hops=0 clientIp=global",
    "TRUST_PROXY="1" -> hops=1 clientIp=7.7.7.7",
    "TRUST_PROXY="2" -> hops=2 clientIp=8.8.8.8",
    "TRUST_PROXY="10" -> hops=10 clientIp=global",
    "TRUST_PROXY="11" -> hops=10 clientIp=global",
    "TRUST_PROXY="999" -> hops=10 clientIp=global",
    "TRUST_PROXY="-1" -> hops=0 clientIp=global",
    "TRUST_PROXY="1.5" -> hops=0 clientIp=global",
    "TRUST_PROXY="abc" -> hops=0 clientIp=global",
    "TRUST_PROXY=" 2 " -> hops=2 clientIp=8.8.8.8",
    "TRUST_PROXY="0x2" -> hops=2 clientIp=8.8.8.8",
    "TRUST_PROXY="1e1" -> hops=10 clientIp=global",
  ],
  "rows": [
    "undefined -> hops0=global hops1=global hops2=global hops3=global hops5=global hops-1=global",
    """ -> hops0=global hops1=global hops2=global hops3=global hops5=global hops-1=global",
    ""1.2.3.4" -> hops0=global hops1=1.2.3.4 hops2=global hops3=global hops5=global hops-1=global",
    "" 1.2.3.4 " -> hops0=global hops1=1.2.3.4 hops2=global hops3=global hops5=global hops-1=global",
    ""spoofed, 1.2.3.4, 10.0.0.1" -> hops0=global hops1=10.0.0.1 hops2=1.2.3.4 hops3=spoofed hops5=global hops-1=global",
    ""a,,b, ,c" -> hops0=global hops1=c hops2=b hops3=a hops5=global hops-1=global",
    ""," -> hops0=global hops1=global hops2=global hops3=global hops5=global hops-1=global",
    ""2001:db8::1, 10.0.0.1" -> hops0=global hops1=10.0.0.1 hops2=2001:db8::1 hops3=global hops5=global hops-1=global",
  ],
}
`;

