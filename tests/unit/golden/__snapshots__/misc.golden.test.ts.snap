exports[`golden: admin session token > verifyToken table 1`] = `
[
  "valid, same instant -> true",
  "valid, 1 s before issue (not rejected: no nbf) -> true",
  "valid, 7 days minus 1 s -> true",
  "expired, exactly 7 days -> false",
  "expired, 8 days -> false",
  "wrong secret -> false",
  "secret shorter than 32 -> false",
  "secret undefined -> false",
  "token undefined -> false",
  "token empty -> false",
  "garbage -> false",
  "payload replaced -> false",
  "signature truncated -> false",
  "alg none -> false",
  "valid signature but role user -> false",
]
`;

