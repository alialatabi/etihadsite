exports[`golden: GET /api/admin/files/[orderId]/[which] > auth, parameters, downloads from local storage 1`] = `
[
  "not logged in -> 401 [content-type=application/json] {"ok":false,"error":"unauthorized"}",
  "pdf -> 200 [content-type=application/pdf; content-length=15; content-disposition=attachment; filename="EP-261110-AB3C_circle-30x30mm_x20.pdf"; cache-control=private, no-store] <15 bytes sha fbf536c9da41d9f2>",
  "design (png) -> 200 [content-type=image/png; content-length=7; content-disposition=attachment; filename="EP-261110-AB3C_design.png"; cache-control=private, no-store] <7 bytes sha cdf3cefe7ec6253d>",
  "pdf of a 4.24x3 cm rect -> 200 [content-type=application/pdf; content-length=15; content-disposition=attachment; filename="EP-261110-AB3C_rect-42.42x30mm_x20.pdf"; cache-control=private, no-store] <15 bytes sha fbf536c9da41d9f2>",
  "design (jpeg -> .jpg) -> 200 [content-type=image/jpeg; content-length=4; content-disposition=attachment; filename="EP-261110-AB3C_design.jpg"; cache-control=private, no-store] <4 bytes sha ba4f25bf16ba4be6>",
  "pdf, display number with unsafe characters -> 200 [content-type=application/pdf; content-length=15; content-disposition=attachment; filename="EP_26_11__x____circle-30x30mm_x20.pdf"; cache-control=private, no-store] <15 bytes sha fbf536c9da41d9f2>",
  "design (pdf), display number with unsafe characters -> 200 [content-type=application/pdf; content-length=5; content-disposition=attachment; filename="EP_26_11__x____design.pdf"; cache-control=private, no-store] <5 bytes sha 38523c087796e5d5>",
  "legacy order: sheets from offer -> 200 [content-type=application/pdf; content-length=15; content-disposition=attachment; filename="EP-261110-AB3C_circle-30x30mm_x10.pdf"; cache-control=private, no-store] <15 bytes sha fbf536c9da41d9f2>",
  "legacy order: design file is gone -> 404 [] (empty body)",
  "no sheets anywhere: pdf file is gone -> 404 [] (empty body)",
  "no sheets anywhere: design -> 200 [content-type=image/png; content-length=1; content-disposition=attachment; filename="EP-261110-AB3C_design.png"; cache-control=private, no-store] <1 bytes sha 4bf5122f344554c5>",
  "unknown order -> 404 [] (empty body)",
  "bad order id -> 404 [] (empty body)",
  "unknown file kind -> 404 [] (empty body)",
  "upper-case kind -> 404 [] (empty body)",
]
`;

