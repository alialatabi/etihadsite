    "landline-looking phone -> 400 [content-type=application/json] {"ok":false,"error":"invalid_phone","message":"رقم الموبايل غير صحيح."}",
    "bad phone AND bad quantity AND missing upload -> phone wins -> 400 [content-type=application/json] {"ok":false,"error":"invalid_phone","message":"رقم الموبايل غير صحيح."}",
    "sheets below the minimum (9) -> 400 [content-type=application/json] {"ok":false,"error":"invalid_quantity","message":"العدد أو الخامة غير متاحة. ارجع وغيّرها."}",
    "sheets above the maximum (5001) -> 400 [content-type=application/json] {"ok":false,"error":"invalid_quantity","message":"العدد أو الخامة غير متاحة. ارجع وغيّرها."}",
    "disabled material -> 400 [content-type=application/json] {"ok":false,"error":"invalid_quantity","message":"العدد أو الخامة غير متاحة. ارجع وغيّرها."}",
    "bad quantity AND missing upload -> quantity wins -> 400 [content-type=application/json] {"ok":false,"error":"invalid_quantity","message":"العدد أو الخامة غير متاحة. ارجع وغيّرها."}",
    "upload id that does not exist -> 400 [content-type=application/json] {"ok":false,"error":"upload_missing","message":"الملف ما انرفع. ارفعه مرة ثانية."}",
    "missing upload AND too-small size -> upload wins -> 400 [content-type=application/json] {"ok":false,"error":"upload_missing","message":"الملف ما انرفع. ارفعه مرة ثانية."}",
    "circle 4 mm (below the 5 mm minimum) -> 400 [content-type=application/json] {"ok":false,"error":"too_small","message":"القياس أصغر من الحد المسموح."}",
    "rect 300x300 mm (larger than the page) -> 400 [content-type=application/json] {"ok":false,"error":"too_big_for_page","message":"القياس أكبر من الورقة."}",
    "rect 200x50 mm (fits only rotated; rotation is off) -> 400 [content-type=application/json] {"ok":false,"error":"too_big_for_page","message":"القياس أكبر من الورقة."}",
    "too-big size AND corrupt upload -> layout wins -> 400 [content-type=application/json] {"ok":false,"error":"too_big_for_page","message":"القياس أكبر من الورقة."}",
    "300 px JPEG at 120 mm (63.5 dpi) -> 400 [content-type=application/json] {"ok":false,"error":"low_dpi","message":"دقة الصورة قليلة لهذا القياس."}",
    "custom shape with an opaque JPEG -> 400 [content-type=application/json] {"ok":false,"error":"no_alpha","message":"الشكل المخصص يحتاج PNG بخلفية شفافة."}",
    "custom shape with an encrypted PDF (reported as encrypted, not no_alpha) -> 400 [content-type=application/json] {"ok":false,"error":"encrypted","message":"ملف PDF محمي بكلمة سر."}",
    "PNG signature followed by garbage -> 400 [content-type=application/json] {"ok":false,"error":"corrupt","message":"ما قدرنا نقرأ الملف."}",
    "encrypted PDF -> 400 [content-type=application/json] {"ok":false,"error":"encrypted","message":"ملف PDF محمي بكلمة سر."}",
    "unparseable PDF -> 400 [content-type=application/json] {"ok":false,"error":"needs_raster","message":"راح نحوّل الـPDF لصورة."}",
    "stored bytes of an unsupported type -> 400 [content-type=application/json] {"ok":false,"error":"unsupported_type","message":"نوع الملف غير مدعوم."}",
    "wrong HTTP content-type but valid JSON is still parsed -> 400 [content-type=application/json] {"ok":false,"error":"invalid_quantity","message":"العدد أو الخامة غير متاحة. ارجع وغيّرها."}",
  ],
}
`;

