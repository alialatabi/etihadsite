    "lastWarn": [
      "[client]",
      "{"step":"other","message":"m59"}",
    ],
    "warnedOutOf65": 60,
  },
  "rows": [
    "valid minimal -> 204 [] (empty body) | warned=1",
    "valid full, unknown keys dropped -> 204 [] (empty body) | warned=1",
    "invalid step -> 204 [] (empty body) | warned=0",
    "message too long -> 204 [] (empty body) | warned=0",
    "not JSON -> 204 [] (empty body) | warned=0",
    "empty body -> 204 [] (empty body) | warned=0",
    "JSON null -> 204 [] (empty body) | warned=0",
    "declared length over 8 KiB -> 413 [] (empty body) | warned=0",
    "body over 8 KiB without a declared length -> 413 [] (empty body) | warned=0",
  ],
}
`;

